{
  "name": "learning-token-product",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --dir web dev",
    "build:web": "pnpm --dir web build",
    "lint:web": "pnpm --dir web lint",
    "dev:indexer": "pnpm --dir indexer dev",
    "sync:indexer": "pnpm --dir indexer sync:once",
    "typecheck:indexer": "pnpm --dir indexer typecheck",
    "build:contracts": "forge build --root contracts",
    "test:contracts": "forge test --root contracts -vvv"
  }
}
